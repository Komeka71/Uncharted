# Culprit Environment Configuration Example
# Copy this file to .env before starting the application.

# MongoDB Connection String (Atlas or local replica set)
MONGODB_URI=mongodb://localhost:27017/culprit

# LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# API Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# GitHub Integration (Personal Access Token with repo/actions read scope)
GITHUB_TOKEN=your_github_pat_here

# Optional n8n Webhook Outbound Integration (P2)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ci-failure

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
